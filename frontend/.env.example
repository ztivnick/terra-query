# Copy to `.env.local` for dev overrides (gitignored by Vite).

# backend base URL
VITE_TERRA_QUERY_API_URL=http://localhost:8000

# base tile URL + attribution
VITE_TERRA_QUERY_TILE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_TERRA_QUERY_TILE_ATTRIBUTION=Tiles &copy; Esri &mdash; Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community

# optional transparent labels overlay; set to "" to disable
VITE_TERRA_QUERY_LABELS_URL=https://services.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}
VITE_TERRA_QUERY_LABELS_ATTRIBUTION=Labels &copy; Esri
