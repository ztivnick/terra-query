# =============================================================================
# secrets / credentials  --  never commit
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx

# =============================================================================
# logs and temp / scratch files
# =============================================================================
*.log
*.tmp
*.bak
*.orig
*~

# =============================================================================
# operating system junk
# =============================================================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini

# =============================================================================
# editors / IDEs
# =============================================================================
.vscode/
.idea/
.history/
*.swp
*.swo
*.code-workspace

# =============================================================================
# python
# regen: `uv sync`
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.dmypy.json
dmypy.json
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# notebooks - strip outputs but ignore checkpoints
.ipynb_checkpoints/

# =============================================================================
# node / frontend (frontend/ is the slot; tooling TBD)
# regen: `npm install` (or pnpm / bun, whichever the frontend uses)
# =============================================================================
node_modules/
dist/
out/
.next/
.nuxt/
.svelte-kit/
.turbo/
.cache/
.parcel-cache/
*.tsbuildinfo

# =============================================================================
# bulk raster / geo formats  --  never commit; ingest CLIs re-download
# regen: `uv run python -m terra_query.ingest.cli.fetch_naip`
#        `uv run python -m terra_query.ingest.cli.fetch_sentinel2`
#        (plus future LiDAR / OSM fetchers as those steps land)
# =============================================================================
*.tif
*.tiff
*.las
*.laz
*.copc
*.gpkg
*.pbf
*.fgb
*.kmz

# shapefile bundle (5 sibling files form one shapefile; rare to track)
*.shp
*.shx
*.dbf
*.prj
*.cpg

# raster sidecars (GDAL stats / overviews / world files; regen on open)
*.aux.xml
*.ovr
*.tfw
*.wld

# =============================================================================
# derived arrays / vector stores / indices  --  never commit; regen by pipeline
# regen: the pipeline step that produces each (S5 embeddings, S6 vector store)
# =============================================================================
*.npy
*.npz
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
*.zarr/
*.faiss
*.lance
*.duckdb
*.sqlite
*.sqlite3
*.dump

# =============================================================================
# verification PNGs  --  regenerable visual artifacts; not source-of-truth
# regen: any of `eval.review`, `eval.gate_visuals`, `ingest.cli.build_chip_index`,
#        `eval.cli.run_n0_retrieval` -- whichever produced the artifact.
# recursive: covers per-experiment gate dirs (eg `verification/<exp_id>/gate/...`)
# and per-eval-set chip dirs (eg `verification/eval_chips/<eval_set_id>/...`).
# =============================================================================
data/verification/**/*.png

# =============================================================================
# per-experiment pipeline outputs  --  fully regenerable via
# `uv run python -m terra_query.cli.run_experiment`.
# the aoi/ and eval/ subdirs (small reprojected CRS derivatives) stay tracked.
# chip_index.json carries an absolute `source_cog` path so it is
# machine-specific; embedding sidecars carry machine-specific timing
# (peak_rss_mb, embed_wall_clock_s, device) so those are also untracked.
# =============================================================================
data/pipeline_outputs/*/chips/
data/pipeline_outputs/*/embeddings/*.json

# =============================================================================
# model weights manifest carries an absolute `weights_path`. Regenerated by
# `uv run python -m terra_query.embed.cli.fetch_weights`.
# =============================================================================
data/source_downloads/model_weights/manifest.json

# =============================================================================
# ML model weights / checkpoints  --  never commit; refetch from HF / source
# regen: model-download step (lands at S5); cached under
#        data/source_downloads/model_weights/
# =============================================================================
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx
*.gguf
*.tflite
*.pkl
*.joblib

# =============================================================================
# compressed archives (typically bulk downloads)
# =============================================================================
*.zip
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tbz2
*.tar.xz
*.txz
*.gz
*.bz2
*.xz

# =============================================================================
# AI collaborator artifacts  --  kept local only by convention
# Not synced to the remote; share out of band if you need them on another
# machine. Treat README.md and data/README.md as the canonical onboarding;
# the contents of docs/ are an internal working layer for the AI session.
# =============================================================================
.cline/
.clinerules/
.clineignore
.claude/
.cursor/
.aider*
.continue/
docs/
implementation_plan.md
CLAUDE.md
CLAUDE.local.md
